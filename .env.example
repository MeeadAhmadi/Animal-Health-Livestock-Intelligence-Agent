# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Collection safety limits
COLLECTION_CONNECT_TIMEOUT_SECONDS=10
COLLECTION_READ_TIMEOUT_SECONDS=15
COLLECTION_TOTAL_TIMEOUT_SECONDS=60
COLLECTION_MAX_REDIRECTS=5
COLLECTION_MAX_RESPONSE_BYTES=5242880

# PostgreSQL - FastAPI runtime role only
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=li_core
DB_USER=li_app
DB_PASSWORD=CHANGE_ME

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
